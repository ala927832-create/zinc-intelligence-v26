# Zinc Intelligence V2.6.1 data-adapter configuration

# Discord
DISCORD_WEBHOOK_URL=

# LME Next-Day XML (licensed)
# Store credentials as GitHub Actions Secrets; never commit real credentials.
LME_XML_USERNAME=
LME_XML_PASSWORD=
LME_XML_CLIENT_ID=xmlfeeds
LME_XML_TIMEOUT_SECONDS=20

# LME warehouse fallback (official/licensed XLSX/CSV)
LME_WAREHOUSE_REPORT_URL=
LME_WAREHOUSE_REPORT_FILE=data/lme_warehouse_stock.xlsx

# Treatment charge (licensed API or manual CSV)
TC_API_URL=
TC_API_KEY=
TC_API_AUTH_HEADER=Authorization
TC_API_AUTH_PREFIX=Bearer
TC_CSV_FILE=data/tc_manual.csv

# Optional generic V2.6 market API fallback
ZINC_MARKET_API_URL=
ZINC_MARKET_API_KEY=

# Full-OHLC candle feeds; CSV/XLSX/JSON supported
CANDLE_API_KEY=
ZINC_DAILY_CANDLE_URL=
ZINC_1H_CANDLE_URL=
ZINC_15M_CANDLE_URL=

# Local candle fallbacks
ZINC_DAILY_CANDLE_FILE=data/lme_zinc_3m_daily.csv
ZINC_1H_CANDLE_FILE=data/lme_zinc_3m_1h.csv
ZINC_15M_CANDLE_FILE=data/lme_zinc_3m_15m.csv

# Backward-compatible V2.6 names
ZINC_DAILY_CSV_URL=
ZINC_1H_CSV_URL=
ZINC_15M_CSV_URL=
ZINC_DAILY_CSV=data/lme_zinc_3m_daily.csv
ZINC_1H_CSV=data/lme_zinc_3m_1h.csv
ZINC_15M_CSV=data/lme_zinc_3m_15m.csv
